# APP_MODE: "demo" (pure SPA, static build) | "production" (TanStack Start SSR/Server build)
APP_MODE=production

# APP_STORAGE: "convex" (recommended, no pauses) | "local" (localStorage) | "supabase" (Prisma)
APP_STORAGE=convex

# CONVEX: Deployment URL (accepted as PROYECT_CONVEX_URL, PROJECT_CONVEX_URL, or VITE_CONVEX_URL)
# Example: https://happy-otter-123.convex.cloud
PROYECT_CONVEX_URL=https://<your-deployment>.convex.cloud
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
CONVEX_DEPLOYMENT=prod:<your-deployment>

# ENCRYPTION_KEY: 64-character hex string for AES-256-GCM
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AUTH_PASSWORD: master password for the owner login
AUTH_PASSWORD=replace-me-with-a-strong-password

# CRON_SECRET: secret for the /api/cron/poll-usage endpoint (Authorization: Bearer <secret>)
CRON_SECRET=replace-me-with-a-random-secret
