# APP_MODE: "demo" (pure SPA, static build) | "production" (TanStack Start SSR/Server build)
APP_MODE=demo

# APP_STORAGE: "local" (uses localStorage) | "supabase" (uses Prisma/Supabase)
APP_STORAGE=local

# ENCRYPTION_KEY: 64-character hex string for AES-256-GCM
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# DATABASE_URL: PostgreSQL connection string (Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_token_hub
